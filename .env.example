# ─────────────────────────────────────────────────────────────
# ATS Resume Checker — environment variables
# Copy to `.env` and fill in the values:  cp .env.example .env
# Or pull the deployed values:  npx vercel env pull .env.local
#
# This is the complete list (matches the Vercel Production + Preview vars).
# No payment provider (pricing page is a dummy), no email service, and no
# file storage — parsed text lives in Postgres.
# ─────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────
# Neon PostgreSQL connection string (Project → Connect → Connection string).
# Keep `sslmode=require`. Also used by `npm run credits:grant`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"


# ── Authentication (required) ────────────────────────────────
# Signs session cookies. Any random string of 32+ characters.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Set on Vercel but not read by this codebase (grep: 0 hits). Kept for parity
# with the deployment environment; safe to leave empty.
BETTER_AUTH_API_KEY=""

# Google login. Both or neither; if unset the login page hides the Google
# button and shows the "OAuth not configured" notice.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── AI provider: OpenRouter (required) ───────────────────────
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Required — lib/ai/models.ts throws if this is unset (there is no built-in
# fallback model). Browse free models: https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL="openai/gpt-oss-120b:free"

# Full API base; override only to point at a proxy or a test server
# (spec 0004 verify step uses http://127.0.0.1:9/api/v1 to force a failure).
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AI_TIMEOUT_MS="30000"


# ── Optional ─────────────────────────────────────────────────
# Not set on Vercel (VERCEL_URL is provided automatically there). Locally the
# code falls back to http://localhost:3000; set it for a custom domain/proxy.
# BETTER_AUTH_URL="http://localhost:3000"
