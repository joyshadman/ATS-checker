generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  resumes      Resume[]
  coverLetters CoverLetter[]
  aiBalance    AiBalance?
  aiLedger     AiLedger[]
}

model Account {
  id              String   @id @default(cuid())
  userId          String
  accountId       String
  providerId      String
  accessToken     String?
  refreshToken    String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope           String?
  idToken         String?
  password        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Resume {
  id           String   @id @default(cuid())
  userId       String
  title        String
  originalText String?
  improvedText String?
  atsScore     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Structured sections (spec 0001). Null content means upload only.
  content          Json?
  contentText      String?
  contentUpdatedAt DateTime?
  improvedContent  Json?

  // Import (spec 0006): set only on built copies made from an upload.
  importedFromId String?
  importedFrom   Resume?  @relation("ResumeImport", fields: [importedFromId], references: [id], onDelete: SetNull)
  importedCopies Resume[] @relation("ResumeImport")
  importNotice   Json?

  // Viewer appearance (spec 0007). Read through resolveTemplateId / resolveLinkStyle.
  templateId String @default("classic")
  linkStyle  String @default("url")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses   Analysis[]
  interviews Interview[]

  @@index([importedFromId])
}

model CoverLetter {
  id           String   @id @default(cuid())
  userId       String
  title        String?
  originalText String?
  improvedText String?
  score        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Analysis {
  id                  String   @id @default(cuid())
  resumeId            String
  jobDescription      String?
  atsScore            Int?
  keywordScore        Int?
  formattingScore     Int?
  skillsScore         Int?
  experienceScore     Int?
  educationScore      Int?
  grammarScore        Int?
  readabilityScore    Int?
  missingKeywords     String?
  weakBulletPoints    String?
  redundantSections   String?
  formattingProblems  String?
  grammarSuggestions  String?
  skillsMissing       String?
  actionVerbs         String?
  overallImprovements String?
  suggestions         String?
  sourceContentAt     DateTime?
  createdAt           DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Interview {
  id        String   @id @default(cuid())
  resumeId  String
  questions       String?
  sourceContentAt DateTime?
  createdAt       DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

// AI usage limit and credits (spec 0004). Writes go through lib/ai/credits.ts only.

enum AiLedgerKind {
  FREE_USE
  CREDIT_USE
  GRANT
  REFUND
}

enum AiPurpose {
  SUMMARY
  BULLETS
  SKILLS
  IMPORT
}

model AiBalance {
  userId    String   @id
  freeUsed  Int      @default(0)
  credits   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiLedger {
  id         String       @id @default(cuid())
  userId     String
  kind       AiLedgerKind
  amount     Int
  purpose    AiPurpose?
  // Plain text on purpose: deleting a resume never touches billing history.
  resumeId   String?
  refundOfId String?      @unique
  note       String?
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
